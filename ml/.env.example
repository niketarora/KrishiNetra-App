# .env template for ML service
# Copy to .env and fill in your values.

DEBUG=True
LOG_LEVEL=INFO

# Google Earth Engine
GEE_PROJECT_ID=your-project-id-here
# Optional: Path to GEE service account JSON key
# GEE_SERVICE_ACCOUNT_KEY_PATH=/path/to/key.json

# Backend API
BACKEND_URL=http://localhost:4000
# BACKEND_API_KEY=your-api-key-if-needed

# Model paths
MODEL_PATH=./models
CROP_CLASSIFIER_MODEL=crop_classifier_v1.pkl
SOIL_MOISTURE_MODEL_PATH=models/agriculture_baseline_xgboost_v1.json
GROWTH_STAGE_MODEL=growth_stage_v1.h5

# Optional shared secret. Set the same value as backend ML_SERVICE_API_KEY.
ML_SERVICE_API_KEY=

# Sentinel data
SENTINEL1_COLLECTION=COPERNICUS/S1_GRD
SENTINEL2_COLLECTION=COPERNICUS/S2_SR_HARMONIZED
SENTINEL2_CLOUD_THRESHOLD=20
