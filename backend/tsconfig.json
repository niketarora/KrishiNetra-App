{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,

    // Tests declare their globals via `@jest/globals` imports, so no ambient
    // jest types are needed here.
    "types": ["node"]
  },
  // The build emits the server only. Test files are excluded so a type error
  // that lives purely in a test can never break a production deploy (and so
  // dist/ does not ship test code); `npm run typecheck` still covers them via
  // tsconfig.test.json.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
