# KrishiNetra backend - Phase 2.5
# Copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# Supabase project. The anon key is used with the FARMER'S forwarded JWT so RLS
# applies to every query. The service role key bypasses RLS and is used only for
# reference-data writes - never on a path that returns farmer-owned rows.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated. The Expo dev server origin during development.
CORS_ORIGINS=http://localhost:8081

# ---------------------------------------------------------------------------
# Phase 2.5 - data ingestion
# ---------------------------------------------------------------------------
# data.gov.in AGMARKNET daily mandi prices. Register free at https://data.gov.in
# and paste the key here. Without it `npm run ingest:market` stops with a clear
# message and the API keeps reporting market data as not connected.
MARKET_API_KEY=

# Open-Meteo needs NO key. These defaults are correct; override them only to
# point a test at a local fixture server.
# MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
# WEATHER_API_URL=https://archive-api.open-meteo.com/v1/archive
# GEOCODE_API_URL=https://nominatim.openstreetmap.org/reverse

# ---------------------------------------------------------------------------
# Krishi Updates - farm-location-aware information feed
# ---------------------------------------------------------------------------
# GDELT (P0), Google News RSS (fallback-only aggregator, never authoritative),
# NDMA SACHET (P0/P1) and PIB RSS (P1) are all public and need NO key. These
# defaults are correct; override only to point a test at a local fixture
# server.
#
# GDELT_BASE_URL is the *host* only - gdelt.provider.ts appends the fixed
# /api/v2/doc/doc path itself. If https://api.gdeltproject.org is unreachable
# from your network (observed on some Windows setups) but the same API
# answers over plain HTTP, override it locally:
#   GDELT_BASE_URL=http://api.gdeltproject.org
# GDELT_BASE_URL=https://api.gdeltproject.org
# Google News RSS search - used ONLY as a fallback when GDELT fails a query
# or comes back with too few useful agriculture/agritech results after
# filtering (see updates.service.ts's fetchAgricultureNews). Never used for
# official disaster alerts - that stays SACHET's job alone.
# GOOGLE_NEWS_RSS_URL=https://news.google.com/rss/search
# SACHET_CAP_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
# PIB_RSS_URL=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=1

# ---------------------------------------------------------------------------
# Phase 2.5 - avatar intelligence (stage 2.5b)
# ---------------------------------------------------------------------------
# Both are server-side only and must never appear in mobile/ or any
# EXPO_PUBLIC_* variable.
#
# The conversational model. This template previously named ANTHROPIC_API_KEY,
# which config/env.ts has never read - the LLM behind the avatar is Gemini.
GEMINI_API_KEY=
# The same Sarvam key both transcribes the farmer and speaks the answer back.
SARVAM_API_KEY=

# The avatar's voice. Optional - these are the defaults, listed so the voice
# can be changed without reading the code. Run the provider's request with an
# unknown speaker to have it list the ones your plan allows.
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_TTS_SPEAKER=abhilash

# ---------------------------------------------------------------------------
# In-app guide - intent router, farming expert, deep research
# ---------------------------------------------------------------------------
# Each branch degrades on its own: a missing key makes that one branch report
# itself as not connected, and the rest of the guide carries on.

# The farming expert. All three are needed for the expert branch to answer.
LYZR_API_KEY=
LYZR_AGENT_ID=
# The email of the Lyzr account that owns the agent - NOT the farmer. Lyzr
# identifies the account with user_id and the conversation with session_id;
# each farmer gets their own session, all under this one account.
LYZR_USER_ID=
# LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# Deep research - current information, schemes, policy, news.
TAVILY_API_KEY=
# TAVILY_API_URL=https://api.tavily.com/search

# The intent router runs on every request and is the one call on the hot path.
# Leave empty to reuse GEMINI_MODEL; set it to point the router at a lighter,
# faster model without a code change.
# GEMINI_ROUTER_MODEL=

# ---------------------------------------------------------------------------
# Phase 3 - independently deployed Python/FastAPI ML service.
# Use a shared random secret in both backend/.env and ml/.env. The mobile app
# must never receive either value or call this service directly.
# ---------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=