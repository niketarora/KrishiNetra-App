# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase — the anon key is a publishable key, safe in the client because
# every table is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps Android SDK key. Ships inside the APK (unavoidable) — restrict it
# by package name (com.krishinetra.app) + SHA-1 in Google Cloud Console.
GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-key

# Optional: EAS project id for cloud builds.
EAS_PROJECT_ID=

# NEVER put these in this file or anywhere under mobile/:
#   SUPABASE_SERVICE_ROLE_KEY, ML_SERVICE_SECRET, AI_API_KEY, payment secrets.
