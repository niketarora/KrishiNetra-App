# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase — the anon key is a publishable key, safe in the client because
# every table is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# KrishiNetra backend (Phase 2). Farm and profile data travels through this API
# rather than straight to Supabase. On an Android emulator the host machine is
# reachable at 10.0.2.2, not localhost; on a physical device use the host's LAN
# address (for example http://192.168.1.20:4000).
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Mapbox public access token (pk....). Ships inside the app bundle — safe to ship,
# and should be URL/bundle-restricted in the Mapbox console.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# Demo mode. Fills the four surfaces that have no data source yet - crop
# health, growth stage, the sell-or-wait recommendation and the History
# timeline - with SAMPLE values, each drawn in an off-palette violet, behind a
# "SAMPLE DATA" badge, under a banner saying so.
#
# Off unless this reads exactly 'true'. Never enable it in a shipped build:
# presentation only, it writes nothing and the assistant never sees it.
EXPO_PUBLIC_DEMO_MODE=false

# Optional: EAS project id for cloud builds.
EAS_PROJECT_ID=

# NEVER put these in this file or anywhere under mobile/:
#   SUPABASE_SERVICE_ROLE_KEY, ML_SERVICE_SECRET, AI_API_KEY, payment secrets.
